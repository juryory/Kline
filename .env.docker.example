# Docker 部署用的配置：cp .env.docker.example .env.docker 后修改（.env.docker 不要提交）
# 路径、端口、时区在 docker-compose.yml 里固定，这里不用填

# 数据源：直播用本地库
DATA_SOURCE=local
TUSHARE_TOKEN=

# 鉴权（见 README「鉴权」）。生成随机值：docker compose build 之后 docker run --rm kline:latest npm run token -- secret
AUTH_SECRET=
RENDER_KEY=
AUTH_COOKIE=weilu_token
ALLOWED_ORIGINS=https://kline.example.com

# 每日自动同步：时刻（北京时间，可多个，逗号分隔）、星期（1-5 = 周一到周五）
SYNC_AT=17:30
SYNC_DAYS=1-5

# 同步范围（见 README「接入 tushare」）
SYNC_YEARS=3
BOARD_YEARS=all
MACRO_YEARS=all
SYNC_INDICES=
SYNC_THS_TYPES=N,I
