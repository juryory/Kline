# 复制为 .env 后修改

# 数据源：mock | local（Tushare 本地库）| ifind（iFinD 优先，本地 Tushare 补缺）| tushare（直连）
DATA_SOURCE=mock
TUSHARE_TOKEN=

# iFinD 官方 HTTP 接口（不是 FFD）：在服务器填写，凭证不返回浏览器
IFIND_REFRESH_TOKEN=
# 可临时用 access_token 测试；长期运行优先 refresh_token，避免 7 天失效
IFIND_ACCESS_TOKEN=
# 默认日常同步最近 7 个自然日；--backfill 默认补半年分时、权限范围内日线
IFIND_START_DATE=
# 可以独立指定分时/日线起点，避免补半年分时顺带重拉半年日线
IFIND_MINUTE_START_DATE=
IFIND_DAILY_START_DATE=
IFIND_END_DATE=
# 只同步指定本地代码（逗号分隔）；空 = 境内全部日线 + 指数/板块/ETF分时
IFIND_SYMBOLS=
# 新库默认 DB_PATH 同目录的 ifind.db；不可与旧库同路径
IFIND_DB_PATH=
# trial：日线/高频共享周额度；free：按下面两项独立月额度
IFIND_QUOTA_PROFILE=trial
IFIND_WEEKLY_BUDGET=150000000
IFIND_HISTORY_BUDGET=100000000
IFIND_RESERVE_BUDGET=20000000
# 单轮请求数/运行秒数上限；达到后保留断点
IFIND_MAX_REQUESTS=2000
IFIND_MAX_SECONDS=600
# 历史年限与额度是两种权限；默认试用日线近5年
IFIND_HISTORY_YEARS=5
# 盘中实时数据按需拉取（只请求正在查看的标的和排行），无需配置；盘后同步在此时刻后才同步当天
IFIND_CLOSE_CUTOFF=15:30
IFIND_UNIVERSE_FILE=
# 仅 free 模式使用的本地月预算，不是官方账户剩余额度
IFIND_DAILY_BUDGET=900000
IFIND_MINUTE_BUDGET=1400000
# 特殊代码/成交量单位映射 JSON 路径（见 README）；留空使用原代码，不猜测供应商专有代码后缀
IFIND_CODE_MAP_FILE=
# 宏观数据（经济数据库 EDB，额度与行情分开）：首次拉取年数；IFIND_MACRO=0 关闭
IFIND_MACRO_YEARS=5
IFIND_MACRO=1
# 盘中实时板块排行的刷新间隔（毫秒）：只在排行页打开或上屏时请求 iFinD 实时行情
IFIND_LIVE_RANK_MS=60000
# 分钟历史补全（docs/ifind-rollout.md 第 4 节）：1 = 服务进程在工作日 21:30—08:30、周末全天每 20 分钟跑一轮
IFIND_BACKFILL=0
IFIND_BACKFILL_MONTHS=6
# 本机账本的补历史周上限；官方本周用量（含其他终端）到停止线即停；--drain 补满时用 DRAIN_STOP
IFIND_BACKFILL_WEEKLY=50000000
IFIND_BACKFILL_STOP=100000000
IFIND_BACKFILL_DRAIN_STOP=145000000
IFIND_BACKFILL_ETF_TOP=300
# 这些核心指数的 iFinD 日线补全历史（Tushare 成交额只算成分股，口径不同）；留空不补
IFIND_FULL_HISTORY=399001.SZ,399006.SZ

# npm run sync 的设置：本地库路径、同步年数、内置之外要同步的指数（逗号分隔）
DB_PATH=data/market.db
SYNC_YEARS=3
# ETF 日线（5000 积分）+ 复权因子（2000 积分）；默认参与日常同步，0 = 关闭；可单独执行 npm run sync:etf
SYNC_ETF=1
ETF_YEARS=3
# 板块和指数（同花顺板块、申万一级、指数）同步范围：all = 全部历史，或填年数（如 10）
BOARD_YEARS=all
# 宏观数据同步范围：all = 全部历史，或填年数
MACRO_YEARS=all
SYNC_INDICES=
# 同花顺板块类型（需 6000 积分）：N 概念 / I 行业 / R 地域 / S 特色 / ST 风格 / TH 主题 / BB 宽基，逗号分隔
SYNC_THS_TYPES=N,I
# 分时 + 分钟 K（5/15/30/60 分）：需要 tushare 历史分钟权限。按需拉取最近几个月缓存到本地库；0 = 关闭
MINUTE_MONTHS=6
# 分时显示领先指标（黄线）/ 红绿柱的成分股指数（上证 / 深成 / 创业板 自动有），逐个用 index_weight 取成分股
BREADTH_INDICES=000016.SH,000300.SH,000905.SH,000852.SH,000688.SH,899050.BJ
# 收盘后定时同步（服务运行时后台跑，需要对应数据源凭证）：窗口内每 SYNC_EVERY 分钟一次，0 = 关闭；
# SYNC_AT 可另加固定时刻（逗号分隔）；星期 1-5 = 周一到周五。记录见 data/sync-history.jsonl、data/sync-logs/
SYNC_WINDOW=15:30-21:00
SYNC_EVERY=15
SYNC_AT=
SYNC_DAYS=1-5

# 鉴权（见 server/auth.js）。AUTH_SECRET 不填 = 不鉴权，只能在内网用；npm run token -- secret 可生成随机值
# AUTH_SECRET 与围炉工作台签发 JWT 用的密钥一致；RENDER_KEY 给 vMix 直播画面用：/render?key=<RENDER_KEY>
AUTH_SECRET=
RENDER_KEY=
# 登录 Cookie 名（与工作台一致）；允许的页面来源，逗号分隔，不填 = 只允许与服务同域名
AUTH_COOKIE=weilu_token
ALLOWED_ORIGINS=

# 服务监听；0.0.0.0 让导播机能通过内网 IP 访问
HOST=0.0.0.0
PORT=8787

# 行情缓存有效期 / 当前标的后台刷新间隔（毫秒）
CACHE_TTL_MS=300000
REFRESH_MS=300000
